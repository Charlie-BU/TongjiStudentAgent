# CORS：允许调用 API 的前端 Origin，使用 JSON 数组；不配置则不允许跨域访问。
# 必须包含同济开放平台的 Origin https://app.tongji.edu.cn，否则无法正常登录。
# CORS_ALLOW_ORIGINS='["https://app.tongji.edu.cn", "http://localhost:5173"]'

ENDPOINT_API_KEY=<your-endpoint-api-key>
ENDPOINT_ID=deepseek-v4-flash-ga-260731

VOLC_API_KEY=<your-volc-api-key>

ARK_BASE_URL_CN=https://ark.cn-beijing.volces.com/api/v3

# Ark Viking 知识库
ARK_KNOWLEDGE_ENABLED=true
# ARK_KNOWLEDGE_COLLECTION=TongjiStudent
ARK_KNOWLEDGE_PROJECT=default
ARK_KNOWLEDGE_RESOURCE_ID=<your-knowledge-resource-id>
ARK_KNOWLEDGE_LIMIT=5
ARK_KNOWLEDGE_DOMAIN=api-knowledgebase.mlp.cn-beijing.volces.com

# MCP Server
MCP_SERVER_URL=http://localhost:3000/mcp    # TODO：上线前替换为生产环境地址
MCP_TIMEOUT=20s

# 会话存储：认证会话使用 PostgreSQL，匿名会话使用 Redis；两项均为启动必填
# POSTGRES_DSN=postgres://<username>:<password>@127.0.0.1:5432/tongji_student?sslmode=disable
POSTGRES_DSN=postgres://<username>:<password>@<db-host>:5432/tongji_student?sslmode=disable
REDIS_URL=redis://default:<password>@<redis-host>:6379/0
# SESSION_ANONYMOUS_TTL=24h
# SESSION_ANONYMOUS_MAX_MESSAGES=20
# SESSION_HISTORY_MAX_MESSAGES=20

# 沙箱集成
SANDBOX_ENABLED=false   # 本阶段暂时不需要沙箱集成

# CozeLoop
COZELOOP_ENABLED=true
COZELOOP_WORKSPACE_ID=<your-cozeloop-workspace-id>
COZELOOP_JWT_OAUTH_CLIENT_ID=<your-cozeloop-client-id>
COZELOOP_JWT_OAUTH_PUBLIC_KEY_ID=<your-cozeloop-public-key-id>
COZELOOP_JWT_OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
<YOUR_PRIVATE_KEY_HERE>
-----END PRIVATE KEY-----"

# 同济开放平台配置
TONGJI_OPEN_PLATFORM_CLIENT_ID=<your-open-platform-client-id>
TONGJI_OPEN_PLATFORM_CLIENT_SECRET=<your-open-platform-client-secret>
TONGJI_OPEN_PLATFORM_REDIRECT_URI=https://app.tongji.edu.cn/wallbreakerAuth/callback.html       # PROD
# TONGJI_OPEN_PLATFORM_REDIRECT_URI=http://localhost:5173/oauth/callback                        # DEV
TONGJI_OPEN_PLATFORM_STATE_SECRET=<your-open-platform-state-secret>

# 可选配置，默认值为同济开放平台官方文档中的值
TONGJI_OPEN_PLATFORM_AUTHORIZATION_ENDPOINT=https://api.tongji.edu.cn/keycloak/realms/OpenPlatform/protocol/openid-connect/auth
TONGJI_OPEN_PLATFORM_TOKEN_ENDPOINT=https://api.tongji.edu.cn/v1/token
TONGJI_OPEN_PLATFORM_API_BASE_URL=https://api.tongji.edu.cn
TONGJI_OPEN_PLATFORM_TIMEOUT_SECONDS=10
